<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Receives session updates from the paired device even when the app is not running. -->
        <service
            android:name="com.pradarshana.core.data.sync.PradarshanaWearableListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/pradarshana"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
